{
	"name": "@twin-dev/trade-documents-transformer",
	"version": "0.0.6",
	"description": "Transformation logic from a war schema into a semantic one",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-trade-documents.git",
		"directory": "packages/trade-documents-transformer"
	},
	"author": "jose.cantera@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build:compile": "tspc",
		"build": "npm run build:compile",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/data-core": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/nameof": "next",
		"@twin.org/standards-unece": "next",
		"@twin-dev/trade-documents-models": "0.0.6"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"ld-contexts",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"models",
		"types",
		"schemas"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-trade-documents/issues"
	},
	"homepage": "https://twindev.org"
}
