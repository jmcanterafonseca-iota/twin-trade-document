{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/PaymentTerms",
	"title": "PaymentTerms",
	"description": "The terms of payment agreed for a trade document.",
	"type": "object",
	"properties": {
		"paymentTermsTypeCode": {
			"type": "array",
			"items": {
				"anyOf": [
					{
						"$ref": "https://schema.twindev.org/unece/UnecePaymentTermsTypeCodeList"
					},
					{
						"type": "string"
					}
				]
			},
			"description": "A code specifying the type of trade payment terms."
		}
	},
	"required": [
		"paymentTermsTypeCode"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UnecePaymentTerms"
		}
	]
}
