{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/ReferencedDocument",
	"title": "ReferencedDocument",
	"description": "Another document referenced by a trade document, such as a governing standard\ncontract, a code of conduct or a set of purchase conditions.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "Document",
			"description": "JSON-LD Type."
		}
	},
	"required": [
		"@context",
		"type"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceDocument"
		}
	]
}
