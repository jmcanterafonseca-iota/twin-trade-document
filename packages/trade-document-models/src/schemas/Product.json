{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Product",
	"title": "Product",
	"description": "A product\nx-json-ld-type: https://vocabulary.uncefact.org/TradeProduct",
	"type": "object",
	"properties": {
		"type": {
			"const": "TradeProduct",
			"description": "JSON-LD Type."
		},
		"classificationCode": {
			"type": "string",
			"description": "The code specifying the classification for this trade product."
		},
		"name": {
			"type": "string",
			"description": "Product name"
		},
		"originCountry": {
			"type": "string",
			"description": "Origin country"
		},
		"qualityLevelCode": {
			"type": "string",
			"description": "Quality level code"
		},
		"description": {
			"type": "string",
			"description": "Description"
		},
		"applicableSupplyChainPackage": {
			"$ref": "https://schema.twindev.org/trade-document/ProductPackage",
			"description": "Product package."
		},
		"itemNumber": {
			"type": "string",
			"description": "The SKU\nx-json-ld-property: https://test.uncefact.org/vocabulary/itemNumber"
		}
	},
	"required": [
		"type",
		"classificationCode",
		"applicableSupplyChainPackage"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceTradeProduct"
		}
	]
}
