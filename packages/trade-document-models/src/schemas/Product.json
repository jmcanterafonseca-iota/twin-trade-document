{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Product",
	"title": "Product",
	"description": "A product\nx-json-ld-type: https://vocabulary.uncefact.org/TradeProduct",
	"type": "object",
	"properties": {
		"type": {
			"const": "TradeProduct",
			"description": "JSON-LD Type."
		},
		"classificationCode": {
			"type": "string",
			"description": "The code specifying the classification for this trade product."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "A unique identifier for this trade product."
		},
		"name": {
			"type": "string",
			"description": "A name, expressed as text, for this trade product."
		},
		"description": {
			"type": "string",
			"description": "Description"
		},
		"packaging": {
			"$ref": "https://schema.twindev.org/trade-document/ProductPackage",
			"description": "Product package."
		}
	},
	"required": [
		"type",
		"classificationCode",
		"identifier",
		"name",
		"packaging"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceTradeProduct"
		}
	]
}
