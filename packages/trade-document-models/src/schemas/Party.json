{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Party",
	"title": "Party",
	"description": "A party playing a role\nx-json-ld-type: https://vocabulary.uncefact.org/TradeParty",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "TradeParty",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "A unique identifier of this trade party."
		},
		"name": {
			"type": "string",
			"description": "A name, expressed as text, for this trade party."
		},
		"postalAddress": {
			"$ref": "https://schema.twindev.org/trade-document/Address",
			"description": "Postal Address"
		},
		"telephone": {
			"type": "string",
			"description": "Telephone number\nx-json-ld-property: https://test.uncefact.org/vocabulary/telephone"
		},
		"email": {
			"type": "string",
			"description": "emailAddress\nx-json-ld-property: https://test.uncefact.org/vocabulary/email"
		}
	},
	"required": [
		"@context",
		"type",
		"identifier",
		"name",
		"postalAddress"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceTradeParty"
		}
	]
}
