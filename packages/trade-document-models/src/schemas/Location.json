{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Location",
	"title": "Location",
	"description": "A relevant location\nx-json-ld-type: https://vocabulary.uncefact.org/TradeLocation",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "TradeLocation",
			"description": "JSON-LD Type."
		},
		"locationFunctionTypeCode": {
			"type": "array",
			"items": {
				"anyOf": [
					{
						"$ref": "https://schema.twindev.org/unece/UneceLocationFunctionCodeList"
					},
					{
						"type": "string"
					}
				]
			},
			"description": "A code specifying the type of trade location."
		},
		"unLocationCode": {
			"type": "string",
			"description": "UN Location code\nx-json-ld-property: https://test.uncefact.org/vocabulary/unLocationCode"
		},
		"name": {
			"type": "string",
			"description": "Location name"
		},
		"country": {
			"type": "string",
			"description": "ISO country\nx-json-ld-property: https://vocabulary.uncefact.org/tradeLocationCountryId"
		},
		"countryName": {
			"type": "string",
			"description": "Country name"
		}
	},
	"required": [
		"@context",
		"type",
		"locationFunctionTypeCode"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceTradeLocation"
		}
	]
}
