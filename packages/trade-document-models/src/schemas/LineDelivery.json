{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/LineDelivery",
	"title": "LineDelivery",
	"description": "The delivery facet of a line: how much, packed how, and how much per package.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "LineTradeDelivery",
			"description": "JSON-LD Type."
		},
		"orderQuantity": {
			"$ref": "#/$defs/Quantity",
			"description": "The quantity ordered on this line."
		},
		"perPackageUnitQuantity": {
			"$ref": "#/$defs/Quantity",
			"description": "The net content of one package, such as the kilograms in a bag."
		},
		"includedPackaging": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/trade-document/Packaging"
			},
			"description": "How the goods on this line are packed."
		}
	},
	"required": [
		"@context",
		"type",
		"orderQuantity",
		"perPackageUnitQuantity",
		"includedPackaging"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceLineTradeDelivery"
		}
	],
	"$defs": {
		"Quantity": {
			"title": "Quantity",
			"description": "A counted or measured quantity. The unit itself has no home: IUneceQuantityCode\ndeclares no value property, so `QuantityTypeCode` cannot carry \"KGM\".",
			"type": "object",
			"properties": {
				"@context": {
					"$ref": "https://schema.twindev.org/unece/UneceContextType",
					"description": "JSON-LD Context."
				},
				"type": {
					"const": "QuantityType",
					"description": "JSON-LD Type."
				},
				"QuantityTypeValue": {
					"type": "string",
					"description": "The numeric value."
				}
			},
			"required": [
				"@context",
				"type",
				"QuantityTypeValue"
			],
			"allOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceQuantityType"
				}
			]
		}
	}
}
