{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Amount",
	"title": "Amount",
	"description": "A monetary amount. Both the value and its currency are mandatory: an amount\nwithout one of them cannot be acted on.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "AmountType",
			"description": "JSON-LD Type."
		},
		"AmountTypeValue": {
			"type": "string",
			"description": "A number of monetary units."
		},
		"AmountTypeCurrency": {
			"$ref": "https://schema.twindev.org/unece/UneceAmountCurrency",
			"description": "An amount currency code."
		}
	},
	"required": [
		"@context",
		"type",
		"AmountTypeValue",
		"AmountTypeCurrency"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceAmountType"
		}
	]
}
