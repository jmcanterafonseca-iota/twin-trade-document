{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/LineAgreement",
	"title": "LineAgreement",
	"description": "The pricing facet of a line.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "LineTradeAgreement",
			"description": "JSON-LD Type."
		},
		"agreedPriceProductPrice": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/trade-document/Price"
			},
			"description": "The agreed price for the goods on this line."
		}
	},
	"required": [
		"@context",
		"type",
		"agreedPriceProductPrice"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceLineTradeAgreement"
		}
	]
}
