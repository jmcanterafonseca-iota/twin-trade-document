{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/TradeItem",
	"title": "TradeItem",
	"description": "A Trade item composed by a product, a price and a quantity",
	"type": "object",
	"properties": {
		"suppliedProduct": {
			"$ref": "https://schema.twindev.org/trade-document/Product",
			"description": "The goods on this line, including their description."
		},
		"unitPrice": {
			"$ref": "https://schema.twindev.org/trade-document/MonetaryAmount",
			"description": "Unit price"
		},
		"orderedQuantity": {
			"$ref": "https://schema.twindev.org/trade-document/Measure",
			"description": "Quantity ordered"
		}
	},
	"required": [
		"suppliedProduct",
		"unitPrice",
		"orderedQuantity"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceSupplyChainTradeLineItem"
		}
	]
}
