{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Quantity",
	"title": "Quantity",
	"description": "A counted or measured quantity.",
	"type": "object",
	"properties": {
		"QuantityTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"QuantityTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UneceQuantityCode",
			"description": "The unit code."
		}
	},
	"required": [
		"QuantityTypeValue",
		"QuantityTypeCode"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceQuantityType"
		}
	]
}
