{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Measure",
	"title": "Measure",
	"description": "A measured value such as a weight.",
	"type": "object",
	"properties": {
		"MeasureTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"MeasureTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UneceMeasureCode",
			"description": "The unit code."
		}
	},
	"required": [
		"MeasureTypeValue",
		"MeasureTypeCode"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceMeasureType"
		}
	]
}
