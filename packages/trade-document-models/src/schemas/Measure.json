{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Measure",
	"title": "Measure",
	"description": "A measured value such as a weight.\nx-json-ld-type: https://vocabulary.uncefact.org/Measurement",
	"type": "object",
	"properties": {
		"type": {
			"const": "MeasureType",
			"description": "JSON-LD Type."
		},
		"MeasureTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"MeasureTypeCode": {
			"type": "string",
			"description": "Measure type code"
		}
	},
	"required": [
		"type",
		"MeasureTypeValue"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceMeasureType"
		}
	]
}
