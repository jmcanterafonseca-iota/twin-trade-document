{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/ProductPackage",
	"title": "ProductPackage",
	"description": "How the goods are packed\nx-json-ld-type: https://vocabulary.uncefact.org/SupplyChainPackaging",
	"type": "object",
	"properties": {
		"type": {
			"const": "SupplyChainPackaging",
			"description": "JSON-LD Type."
		},
		"packageTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UnecePackageTypeCodeList",
			"description": "The code specifying the type of supply chain packaging."
		},
		"capacityMeasure": {
			"$ref": "https://schema.twindev.org/trade-document/Measure",
			"description": "Capacity measure"
		}
	},
	"required": [
		"type",
		"packageTypeCode",
		"capacityMeasure"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceSupplyChainPackaging"
		}
	]
}
