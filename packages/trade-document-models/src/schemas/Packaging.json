{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/trade-document/Packaging",
	"title": "Packaging",
	"description": "How the goods are packed: the coded package type, plus its trade name in\n`description` when the document names a brand such as a hermetic liner.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "SupplyChainPackaging",
			"description": "JSON-LD Type."
		},
		"packageTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UnecePackageTypeCodeList",
			"description": "The code specifying the type of supply chain packaging."
		}
	},
	"required": [
		"@context",
		"type",
		"packageTypeCode"
	],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/unece/UneceSupplyChainPackaging"
		}
	]
}
